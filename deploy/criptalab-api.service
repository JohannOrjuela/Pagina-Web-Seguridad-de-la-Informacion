[Unit]
Description=CriptaLab FastAPI
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/criptalab/backend
Environment=APP_ENV=production
Environment=AUTH_ENABLED=false
ExecStart=/opt/criptalab/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

