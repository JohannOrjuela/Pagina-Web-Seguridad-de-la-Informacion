[Unit]
Description=CriptaLab React frontend
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/criptalab/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --host 127.0.0.1 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
